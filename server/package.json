{
  "name": "@reader/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/infrastructure/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/infrastructure/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/infrastructure/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "fast-xml-parser": "^5.3.0",
    "he": "^1.2.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
